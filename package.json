{
  "name": "@jflowers/opencode-profile-switcher",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode plugin for seamless switching between configuration profiles via a /profile slash command",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./tui.tsx"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build",
    "dev": "opencode plugin dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "profile",
    "configuration",
    "switcher"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jflowers/opencode-profile-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/jflowers/opencode-profile-switcher/issues"
  },
  "homepage": "https://github.com/jflowers/opencode-profile-switcher#readme",
  "author": "jflowers",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  },
  "dependencies": {
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.10",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/",
    "lib/",
    "tui.tsx",
    "README.md",
    "LICENSE"
  ]
}